{
    "name": "bear/ssr-module",
    "description": "Javascript SSR module for BEAR.Sunday",
    "keywords": [
        "Javascript",
        "SSR",
        "V8",
        "React"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "bear/resource": "^1.15",
        "koriym/baracoa": "^1.0",
        "ray/aop": "^2.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpv8/v8js-stubs": "^1.4",
        "symfony/cache": "^7.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\SsrModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\SsrModule\\": [
                "tests/",
                "tests/Fake"
            ]
        }
    },
    "scripts": {
        "test": "php -d apc.enable_cli=1 vendor/bin/phpunit --coverage-text",
        "tests": ["@cs", "@sa", "@test"],
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "sa": "phpstan analyse"
    }
}
